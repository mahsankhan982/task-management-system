PORT=5000
CLIENT_URL=http://localhost:3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=task_app
DB_PASSWORD=change_me
DB_NAME=task_management
INSTANCE_UNIX_SOCKET=

JWT_SECRET=change_me_to_a_long_random_secret

# Google sign-in (optional). Create an OAuth 2.0 Client ID of type
# "Web application" at https://console.cloud.google.com/apis/credentials
# and add your web origin to "Authorised JavaScript origins".
# Leave blank to disable the Google button entirely.
GOOGLE_CLIENT_ID=

# Password reset email (Gmail SMTP example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM=Task Manager <your-sender@gmail.com>