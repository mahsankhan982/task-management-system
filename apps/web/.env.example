# Base URL of the Task Management API (include the /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google sign-in (optional). Must be the SAME OAuth 2.0 Client ID that the
# API uses for GOOGLE_CLIENT_ID. Create it at
# https://console.cloud.google.com/apis/credentials as type "Web application"
# and add this app's origin under "Authorised JavaScript origins".
# Leave blank to hide the Google button and keep password-only sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
